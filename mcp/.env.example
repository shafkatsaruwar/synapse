# Synapse MCP local env (placeholders only — never commit real values)

# Required for Cursor headers / stdio
SYNAPSE_MCP_TOKEN=

# Cloud backup (same Supabase project the app already uses)
SYNAPSE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SYNAPSE_SUPABASE_ANON_KEY=

# Optional: your user JWT so the server reads user_backups via RLS
SYNAPSE_OWNER_ACCESS_TOKEN=

# Optional: only if you must use the service role (always pair with owner id)
# SYNAPSE_OWNER_USER_ID=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional local Privacy export (stdio / private host)
# SYNAPSE_BACKUP_JSON=/absolute/path/to/synapse-export.json
