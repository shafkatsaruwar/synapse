# Vision provider — set ONE of these after approval. Never commit real keys.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Provider selection: openai | anthropic | gemini | mock
USABILITY_VISION_PROVIDER=mock

# Model override (provider-specific). Examples:
# USABILITY_VISION_MODEL=gpt-4o
# USABILITY_VISION_MODEL=claude-sonnet-4-20250514
# USABILITY_VISION_MODEL=gemini-2.0-flash

# Maestro / simulator
MAESTRO_BIN=maestro
USABILITY_APP_ID=com.mohammedsaruwar.synapse
USABILITY_DEVICE=iPhone 16
USABILITY_OUTPUT_DIR=./reports

# Safety (defaults are safe)
USABILITY_ALLOW_PURCHASES=false
USABILITY_ALLOW_NOTIFICATIONS=false
USABILITY_ALLOW_MESSAGES=false
USABILITY_ALLOW_REAL_ACCOUNTS=false
